# ============================================================================
# 客服回复幻觉检测 —— 环境变量模板
#
# 用法：复制成 .env 后按需修改
#     cp .env.example .env
#
# ----------------------------------------------------------------------------
# 【这里没有模型凭据】
# 检测用的地址、密钥、模型名由调用方在页面上现填，随请求发给本机后端，用完即弃。
# 服务端不持有、不缓存任何凭据，所以这个文件里不需要、也不应该出现 API key。
# ----------------------------------------------------------------------------
#
# 【格式硬约束】这个文件会被两个解析器读取，写法必须落在交集之内：
#     1. Spring Boot —— 通过 spring.config.import 用 properties 解析器读
#     2. docker run --env-file / docker compose 的 env_file
#
#   ✗ 不要写  export KEY=value
#       Spring Boot 会把 "export" 当成键名；
#       docker run --env-file 会直接报错退出：variable 'export KEY' contains whitespaces
#
#   ✗ 不要给值加引号
#       Spring Boot 与 Docker 都【不会】剥离引号，引号会成为值的一部分
#
#   ✗ 不要写行尾注释
#       会被当成值的一部分传进去
#
#   ✓ 只写 KEY=value，注释独占一行，以 # 开头
# ============================================================================


# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
# 对外端口
SERVER_PORT=8080
